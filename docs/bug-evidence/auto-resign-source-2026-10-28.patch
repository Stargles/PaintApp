-# --- Make sure we are about to build main, and nothing else ---
-log "Syncing $PROJECT_DIR to origin/main..."
+# Select a build source that never moves backwards from the last installed source.
+# The caller has already fetched origin and verified the configured checkout is clean.
+# Return the selected full commit SHA on stdout; return nonzero for missing, invalid,
+# unavailable, or unrelated provenance. Do not guess from the current branch or app path.
+select_build_source() {
+    local repo=$1 last_source_sha=$2 main_sha=$3 resolved_last resolved_main
+    [[ "$last_source_sha" =~ ^[0-9a-f]{40}$ ]] || return 2
+    if ! resolved_last=$(run_as_user /usr/bin/git -C "$repo" rev-parse --verify "${last_source_sha}^{commit}" 2>/dev/null); then
+        return 2
+    fi
+    if [[ "$resolved_last" != "$last_source_sha" ]]; then
+        return 2
+    fi
+    if ! resolved_main=$(run_as_user /usr/bin/git -C "$repo" rev-parse --verify "${main_sha}^{commit}" 2>/dev/null); then
+        return 2
+    fi
+    if [[ "$resolved_main" != "$main_sha" ]]; then
+        return 2
+    fi
+
+    if run_as_user /usr/bin/git -C "$repo" merge-base --is-ancestor "$last_source_sha" "$main_sha" >/dev/null 2>&1; then
+        printf '%s\n' "$main_sha"
+        return 0
+    fi
+    if run_as_user /usr/bin/git -C "$repo" merge-base --is-ancestor "$main_sha" "$last_source_sha" >/dev/null 2>&1; then
+        printf '%s\n' "$last_source_sha"
+        return 0
+    fi
+    return 2
+}
+
+# Move the already-clean managed checkout to the selected immutable source and verify it.
+checkout_build_source() {
+    local repo=$1 source_sha=$2 head_sha
+    if ! run_as_user /usr/bin/git -C "$repo" checkout --detach "$source_sha" >/dev/null 2>&1; then
+        return 2
+    fi
+    if ! head_sha=$(run_as_user /usr/bin/git -C "$repo" rev-parse HEAD); then
+        return 2
+    fi
+    [[ "$head_sha" == "$source_sha" ]]
+}
+
+# Persist source provenance beside the profile fields, only after the install succeeded.
+write_success_state() {
+    local state_file=$1 app_path=$2 source_sha=$3 expiration=$4 creation=$5 temp_file
+    [[ "$source_sha" =~ ^[0-9a-f]{40}$ ]] || return 2
+    if ! temp_file=$(mktemp "${state_file}.tmp.XXXXXX"); then
+        return 2
+    fi
+    if ! printf 'LAST_APP_PATH=%s\nLAST_SOURCE_SHA=%s\nLAST_PROFILE_EXPIRATION=%s\nLAST_PROFILE_CREATION=%s\n' \
+        "$app_path" "$source_sha" "$expiration" "$creation" > "$temp_file"; then
+        rm -f "$temp_file"
+        return 2
+    fi
+    if ! mv -f "$temp_file" "$state_file"; then
+        rm -f "$temp_file"
+        return 2
+    fi
+    return 0
+}
 
+# --- Make sure we are about to build a monotonic source ---
+log "Syncing $PROJECT_DIR and selecting source from origin/main..."
+
 if ! run_as_user /usr/bin/git -C "$PROJECT_DIR" fetch --prune origin >/dev/null 2>&1; then
